# DeepClean AI 分析服务配置模板
# 复制为 backend/.env 并填入真实配置 (backend/.env 已被 .gitignore 忽略)
# 支持任何 OpenAI 兼容接口: 火山方舟Ark / OpenAI / DeepSeek / Ollama 等

# 接口地址: 火山方舟示例 (OpenAI: https://api.openai.com/v1, Ollama: http://127.0.0.1:11434/v1)
base_url=https://ark.cn-beijing.volces.com/api/v3

# API Key (本地 Ollama 可留空)
api_key=

# 模型 ID / 名称 (方舟推理接入点 ep-xxx / gpt-4o-mini / qwen2.5:7b)
model=

# 采样温度 0~2 (越小越确定, 文件分析建议 0.3)
temperature=0.3

# 单次回复最大 Token 数
max_tokens=2000

# 请求超时(秒)
timeout=60
